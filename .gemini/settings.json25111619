	    "/src/Miadi-46",
	    "/opt/binscripts",
	    "/src/_sessiondata",
	    "/w/CSV/kb2508",
	    "/src/IAIP",
	    "/src/holisticagnostic-narrative-context-protocol/"
          ],         
          "env": {}
        }
  }
}

